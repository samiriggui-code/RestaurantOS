<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1412"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Mise à jour WebView"
        android:textColor="#e8e4dc"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/upgrade_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Téléchargement du moteur Chromium…"
        android:textColor="#a8a29e"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/upgrade_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Premier lancement uniquement (~100 Mo).\nWi‑Fi recommandé."
        android:textColor="#78716c"
        android:textSize="12sp" />
</LinearLayout>
