{
  "name": "restaurantos",
  "version": "1.0.0",
  "private": true,
  "description": "A full-featured bilingual (AR/EN) restaurant & café management system",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev:stop": "node scripts/kill-dev-ports.mjs",
    "dev": "node scripts/dev.mjs dev",
    "dev:mobile": "node scripts/dev.mjs mobile",
    "dev:legacy": "node scripts/dev.mjs legacy",
    "dev:client": "node scripts/dev.mjs client",
    "dev:web": "node scripts/dev.mjs web",
    "dev:server": "node scripts/dev.mjs server",
    "dev:all": "node scripts/dev.mjs all",
    "dev-inner-server": "npm run dev --prefix server",
    "dev-inner-web": "npm run dev --prefix app.pizzeria.fr",
    "dev-inner-web:https": "npm run dev:https --prefix app.pizzeria.fr",
    "dev-inner-client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix app.pizzeria.fr",
    "build:web": "npm run build --prefix app.pizzeria.fr",
    "build:server": "npm run build --prefix server",
    "test": "npm run test --prefix server",
    "test:client": "npm test --prefix client",
    "test:server": "npm test --prefix server",
    "test:coverage": "npm run test --prefix server -- --coverage",
    "lint": "npm run lint --prefix server && npm run lint --prefix app.pizzeria.fr",
    "lint:fix": "npm run lint --prefix server -- --fix && npm run lint --prefix app.pizzeria.fr -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix app.pizzeria.fr",
    "db:generate": "npm run prisma:generate --prefix server",
    "db:push": "npm run prisma:push --prefix server",
    "db:repair": "npm run dev:stop && npm run prisma:repair --prefix server",
    "db:sync": "npm run prisma:repair --prefix server",
    "db:migrate": "npm run prisma:migrate --prefix server",
    "db:seed": "npm run prisma:seed --prefix server",
    "sync:catalog": "npm run sync:catalog --prefix server",
    "seed:ops": "npm run seed:ops --prefix server",
    "db:studio": "npx prisma studio --prefix server",
    "db:reset": "npm run prisma:reset --prefix server",
    "db:backup": "bash scripts/backup-db.sh",
    "db:backup:win": "powershell -File scripts/backup-db.ps1",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "setup": "npm install && npm install --prefix server && npm install --prefix app.pizzeria.fr && npx prisma generate --prefix server && npx prisma db push --prefix server && npx tsx prisma/seed.ts --prefix server",
    "prepare": "husky",
    "test:smoke": "k6 run tests/load/smoke-test.js",
    "test:load": "k6 run tests/load/average-load.js",
    "test:stress": "k6 run tests/load/stress-test.js",
    "test:spike": "k6 run tests/load/spike-test.js",
    "test:e2e": "echo \"No app.pizzeria.fr e2e suite configured yet\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "server/**/*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
