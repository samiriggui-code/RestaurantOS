# =============================================================================
# RestaurantOS Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# 🔐 SECURITY WARNING:
# Never commit .env files. Never use default secrets in production.
# Generate all secrets with: openssl rand -base64 32
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Start PostgreSQL locally: docker compose up postgres -d
# Or use your own PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Minimum length: 32 characters
JWT_SECRET="change-this-to-a-very-long-random-string"
REFRESH_SECRET="change-this-to-another-long-random-string"

# Token expiry durations
# Format: numeric + unit (s=seconds, m=minutes, h=hours, d=days)
JWT_EXPIRES_IN="15m"        # Access token lifetime (short-lived)
JWT_REFRESH_EXPIRES_IN="7d" # Refresh token lifetime

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development        # Set to "production" for deployment
# TRUST_PROXY=1             # Uniquement derrière Traefik/Caddy (sinon spoof X-Forwarded-For)
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"  # CORS + Socket.io (comma-separated)
UPLOAD_DIR="./uploads"      # Where menu images are stored
BACKUP_DIR="./backups"      # Where DB backups are saved

# Mono-tenant La Z Pizza (CDC A3)
BUSINESS_ID="00000000-0000-0000-0000-000000000001"
ENABLED_MODULES="menu,pos,kiosk,kitchen,orders,reports,users,settings,expenses,loyalty,shifts"

# ─── Marketplaces (Deliveroo / Uber Eats) ────────────────────────────────────
# Webhooks : POST /api/public/webhooks/deliveroo | /ubereats
# Auth Bearer ou header X-Webhook-Signature (HMAC SHA-256 du corps JSON)
# DELIVEROO_WEBHOOK_SECRET=
# UBER_EATS_WEBHOOK_SECRET=

# ─── Email (Laragon Mailpit) ─────────────────────────────────────────────────
# EMAIL_SERVER_HOST="127.0.0.1"
# EMAIL_SERVER_PORT=1025
# EMAIL_FROM="commandes@lazpizza.test"
# PUBLIC_SITE_URL="http://pizzeria.test"

# ─── SMS / WhatsApp (optionnel) ──────────────────────────────────────────────
# SMS_PROVIDER=twilio
# SMS_PROVIDER=twilio_whatsapp
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_PROVIDER=meta
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_ID=
# SMS_SENDER_NAME=La Z Pizza

# ─── Traefik IP sync (prod Docker) ─────────────────────────────────────────
# TRAEFIK_DYNAMIC_DIR=/traefik-dynamic

# ─── SumUp (paiement / Solo — local sandbox) ───────────────────────────────
# SUMUP_API_KEY="sup_sk_..."              # serveur uniquement
# SUMUP_PUBLIC_KEY="sup_pk_..."           # widget JS (ou NEXT_PUBLIC_SUMUP_PUBLIC_KEY)
# SUMUP_MERCHANT_CODE=
# SUMUP_MODE="sandbox"
# API_PUBLIC_BASE_URL="https://api.pizzeria.fr"  # return_url du checkout SumUp (paiement en ligne)

# ─── Conformité article 286 CGI (ISCA) ─────────────────────────────────────
# FISCAL_HMAC_SECRET=   # openssl rand -base64 32 (dédié ; sinon JWT_SECRET)
# FISCAL_SOFTWARE_VERSION=1.0.0

# ─── Pennylane (pont comptable — export factures) ──────────────────────────
# Préféré : coller le token dans Admin → Intégrations → Pennylane (stocké en BDD).
# Repli legacy VPS uniquement si besoin :
# PENNYLANE_API_TOKEN=
# PENNYLANE_INVOICE_DRAFT=true

# ─── Sentry (Optional) ───────────────────────────────────────────────────────
# SENTRY_DSN="https://key@o0.ingest.sentry.io/0"

# ─── Commandes en ligne (test local) ─────────────────────────────────────────
# En développement : créneaux jusqu'à 23h45 (prod = 21h45, fermeture 22h).
# ORDER_TEST_SLOTS=true   # forcer en staging
# ORDER_TEST_SLOTS=false  # simuler la prod en local

# ─── Synchro auto reporting (SumUp transactions + dépenses Pennylane) ───────
# REPORTING_AUTO_SYNC=true            # false = synchro manuelle uniquement (Admin → Intégrations)
# REPORTING_SYNC_INTERVAL_MIN=15
